  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://rpehngjvwcnipvkouluu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "custom-cms",
      "version": "0.1.0",
      "title": "Custom CMS"
    },
    "tools": [
      {
        "name": "list_casinos",
        "title": "List casinos",
        "description": "List the casinos the signed-in user can access (id, name, slug).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_day_closings",
        "title": "Get day closings",
        "description": "Read closed business-day results (tables, slots, cash desk) for one casino in a date range (max 62 days).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "casino_id": {
              "type": "string",
              "format": "uuid",
              "description": "Casino id from list_casinos."
            },
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "First business date, YYYY-MM-DD."
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Last business date, YYYY-MM-DD."
            }
          },
          "required": [
            "casino_id",
            "from",
            "to"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_players",
        "title": "Search players",
        "description": "Find players by name, nickname or phone (up to 25 results).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60,
              "description": "Part of the name, nickname or phone."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
